# One line ending in the repository, whatever the working tree uses. Without
# this a Windows checkout commits CRLF and a Linux one sees the whole file as
# changed, which buries real diffs.
* text=auto eol=lf

*.rs    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# RTSP puts CRLF on the wire, and retina's captured exchanges are the bytes as
# sent. Normalising them breaks the tests that parse them.
third_party/retina/src/**/testdata/** -text

*.png binary
*.jpg binary
*.flv binary
